---
import '../styles/global.css';
import { MapPinIcon } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	theme="dark"
	content={{
		title: 'Micra | Escritório de Arquitetura',
		description: 'Micra é um escritório de arquitetura que busca a excelência em cada projeto, com atenção aos detalhes e foco na experiência do usuário.'
	}}
>
	<section class="self-end flex flex-col w-full items-center justify-end px-6 py-6 gap-5">
		<img
			src="/assets/icon/icon-micra-branco.svg"
			alt=""
			aria-hidden="true"
			class="mb-12 h-16 w-16 md:h-20 md:w-20"
		/>

		<address class="not-italic mb-12 flex items-center justify-center gap-3 leading-relaxed">
			<MapPinIcon class="h-8 w-8 shrink-0 text-foreground" aria-hidden="true" focusable="false" />
			<p class="text-start text-sm font-primary font-light">Rua Aulete Martins Menezes, 290/B · Albinópolis · Conselheiro Lafaiete · MG</p>
		</address>

		<ul class="m-0 p-0 mb-12 flex list-none flex-col items-start leading-relaxed sm:text-lg">
			<li>
				<a
					href="#"
					class="text-lg font-primary font-normal text-foreground hover:text-foreground-hover hover:decoration-foreground-hover"
					aria-label="Enviar e-mail para contato da Micra"
				>
					contato@micraarquitetura.com.br
				</a>
			</li>
			<li>
				<a
					href="#"
					class="text-lg font-primary font-light text-foreground hover:text-foreground-hover hover:decoration-foreground-hover"
					aria-label="Enviar mensagem pelo WhatsApp da Micra"
				>
					+55 (31) 99420-8743
				</a>
			</li>
			<li>
				<a
					href="#"
					class="text-lg font-primary font-light text-foreground hover:text-foreground-hover hover:decoration-foreground-hover"
					aria-label="Visitar o Instagram da Micra"
				>
					@micraarquitetura
				</a>
			</li>
		</ul>

		<div class="h-px w-full bg-foreground-active" />

		<div class="w-full flex flex-col align-center justify-center text-center font-primary font-light text-[10px] text-foreground">
			<p>Micra Arquitetura<span class="ml-1.5">©</span>2026 - Desenvolvido com S2 por Jaderson</p>
		</div>
	</section>
</BaseLayout>
