---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import CardCarousel from '../components/CardCarousel.astro';

import { Plus } from "@lucide/astro"

import type { Card } from '../types/card-carousel';

const projects: Card[] = [
	{
		id: 'casa-ipe',
		imageSrc: '/assets/img/carousel-sample-01.webp',
		imageAlt: 'Projeto de arquitetura residencial',
		title: 'Casa Ipê',
		tags: ['Residencial', 'Arquitetura']
	},
	{
		id: 'casa-costa',
		imageSrc: '/assets/img/carousel-sample-02.webp',
		imageAlt: 'Projeto de casa contemporânea',
		title: 'Casa Costa',
		tags: ['Interiores', 'Residencial']
	},
	{
		id: 'casa-patio',
		imageSrc: '/assets/img/carousel-sample-03.webp',
		imageAlt: 'Projeto de casa com pátio',
		title: 'Casa Pátio',
		tags: ['Reforma', 'Arquitetura']
	},
	{
		id: 'casa-horizonte',
		imageSrc: '/assets/img/carousel-sample-04.webp',
		imageAlt: 'Projeto de residência contemporânea',
		title: 'Casa Horizonte',
		tags: ['Residencial', 'Interiores']
	},
	{
		id: 'edificio-brisa',
		imageSrc: '/assets/img/carousel-sample-05.webp',
		imageAlt: 'Projeto de edifício residencial',
		title: 'Edifício Brisa',
		tags: ['Arquitetura', 'Urbanismo']
	}
];
---

<BaseLayout>
	<section class="w-full h-full flex flex-col items-center justify-end gap-5">
		<CardCarousel
			id="projetos"
			items={projects}
			ariaLabel="Projetos de arquitetura"
			speed={18}
		/>
		<div class="self-start sm:self-center p-6 mb-12 sm:mb-4">

			<a href="/projetos" class="group m-0 flex flex-row gap-x-2 text-theme-dark hover:text-foreground-hover">
				<Plus class="duration-300 ease-in-out group-hover:rotate-90"/>
				<h2 class="font-primary uppercase text-lg font-medium">
					Projetos 
				</h2>
			</a>

			
		</div>
	</section>
</BaseLayout>
