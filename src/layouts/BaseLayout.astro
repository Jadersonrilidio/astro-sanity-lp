---
import '../styles/global.css';
import { ClientRouter, fade } from 'astro:transitions';
import MenuIcon from '../components/icons/MenuIcon.astro';
import CloseIcon from '../components/icons/CloseIcon.astro';

interface Props {
  content?: {
    title: string;
    description: string;
  };
  theme?: 'light' | 'dark';
  isPageHeightFix?: boolean;
}

const { content, theme = 'light', isPageHeightFix = true } = Astro.props;

const title: string = content?.title || 'Micra | Escritório de Arquitetura';
const description: string = content?.description || 'Micra é um escritório de arquitetura que busca a excelência em cada projeto, com atenção aos detalhes e foco na experiência do usuário.';
---

<html lang="pt-BR" data-theme={theme} class="h-full bg-background text-foreground antialiased">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<!-- Import Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Josefin+Sans:ital,wght@0,100..700;1,100..700&family=Outfit:wght@100..900&display=swap" rel="stylesheet">
		
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.svg" />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body transition:animate={fade({ duration: 800 })} class="m-0 flex min-h-screen flex-col bg-background text-foreground font-sans" class={isPageHeightFix ? "max-h-screen" : ""}>
		<div
			id="page-overlay"
			aria-hidden="true"
			class="fixed inset-0 z-100 pointer-events-none bg-background opacity-100 transition-opacity duration-1500 delay-800 ease-out"
		></div>
		<header class="flex h-25 items-center justify-between px-6">
			<a class="inline-flex leading-none" href="/" aria-label="MICRA home">
				<img src={theme === 'dark' ? '/assets/logo-micra-branco.svg' : '/assets/logo-micra.svg'} alt="micra logo" class="h-12 w-auto" />
			</a>

			<button
				type="button"
				class="menu-toggle flex h-12 w-12 flex-col justify-center border-0 bg-transparent p-0 text-foreground hover:text-foreground-hover active:text-foreground-active cursor-pointer"
				aria-label="Abrir menu"
				aria-controls="site-menu"
				aria-expanded="false"
			>
				<MenuIcon />
			</button>

			<!-- Menu Modal -->
			<div
				id="site-menu"
				class="menu fixed inset-0 z-50 flex translate-x-full flex-col bg-menu-background px-6 pb-[12vh] text-menu-foreground opacity-100 invisible pointer-events-none transition-all duration-[1600ms] ease-[cubic-bezier(0.25,1,0.5,1)] motion-reduce:transition-none"
				role="dialog"
				aria-modal="true"
				aria-label="Menu"
			>
				<div class="flex h-25 items-center justify-end">
					<button
						type="button"
						class="menu-close flex h-12 w-12 flex-col justify-center border-0 bg-transparent p-0 text-menu-foreground hover:text-menu-foreground-hover active:text-menu-foreground-active cursor-pointer"
						aria-label="Fechar menu"
					>
						<CloseIcon />
					</button>
				</div>

				<nav class="menu-nav mt-auto" aria-label="Menu principal">
					<ul class="m-0 flex list-none flex-col gap-4 p-0">
						<li><a href="/" class="font-primary font-light text-[clamp(2.5rem,9vw,3rem)] uppercase leading-tight tracking-[0.04em] text-menu-foreground hover:text-menu-foreground-hover active:text-menu-foreground-active no-underline">Início</a></li>
						<li><a href="/sobre" class="font-primary font-light text-[clamp(2.5rem,9vw,3rem)] uppercase leading-tight tracking-[0.04em] text-menu-foreground hover:text-menu-foreground-hover active:text-menu-foreground-active no-underline">Sobre</a></li>
						<li><a href="/projetos" class="font-primary font-light text-[clamp(2.5rem,9vw,3rem)] uppercase leading-tight tracking-[0.04em] text-menu-foreground hover:text-menu-foreground-hover active:text-menu-foreground-active no-underline">Projetos</a></li>
						<li><a href="/contato" class="font-primary font-light text-[clamp(2.5rem,9vw,3rem)] uppercase leading-tight tracking-[0.04em] text-menu-foreground hover:text-menu-foreground-hover active:text-menu-foreground-active no-underline">Contato</a></li>
					</ul>
				</nav>

				<ul class="mt-[clamp(48px,12vh,120px)] flex flex-col items-end">
					<li>
						<a href="#" aria-label="E-mail" class="inline-fit text-lg font-primary font-normal text-menu-foreground hover:text-menu-foreground-hover active:text-menu-foreground-active">
							contato@micraarquitetura.com.br
						</a>
					</li>
					<li>
						<a href="#" aria-label="WhatsApp" class="inline-fit text-lg font-primary font-light text-menu-foreground hover:text-menu-foreground-hover active:text-menu-foreground-active">
							+55 (31) 99420-8743
						</a>
					</li>
					<li>
						<a href="#" aria-label="Instagram" class="inline-fit text-lg font-primary font-light text-menu-foreground hover:text-menu-foreground-hover active:text-menu-foreground-active">
							@micraarquitetura
						</a>
					</li>
				</ul>
			</div>
		</header>

		<main class="flex flex-1 items-center justify-center">
			<slot />
		</main>
	</body>
</html>

<script>
	function fadeOutPageOverlay(): void {
		const overlay = document.getElementById('page-overlay');
		if (!overlay) {
			throw new Error('The page overlay element was not found.');
		}

		if (overlay.style.opacity === '0') return;

		requestAnimationFrame(() => {
			requestAnimationFrame(() => {
				overlay.style.opacity = '0';
			});
		});
	}

	document.addEventListener('astro:page-load', fadeOutPageOverlay);
	if (document.readyState !== 'loading') {
		fadeOutPageOverlay();
	}

	function setMenu(open: boolean): void {
		const menu = document.getElementById('site-menu');
		const openBtn = document.querySelector<HTMLButtonElement>('.menu-toggle');
		const closeBtn = document.querySelector<HTMLButtonElement>('.menu-close');

		if (!menu || !openBtn || !closeBtn) {
			throw new Error('Required menu elements were not found.');
		}

		menu.classList.toggle('pointer-events-auto', open);
		menu.classList.toggle('translate-x-0', open);
		menu.classList.toggle('visible', open);
		menu.classList.toggle('opacity-100', open);
		menu.classList.toggle('pointer-events-none', !open);
		menu.classList.toggle('translate-x-full', !open);
		menu.classList.toggle('invisible', !open);
		menu.classList.toggle('opacity-100', !open);
		document.body.classList.toggle('overflow-hidden', open);
		openBtn.setAttribute('aria-expanded', String(open));
		(open ? closeBtn : openBtn).focus({ preventScroll: true });
	}

	document.addEventListener('click', (event: MouseEvent) => {
		if (!(event.target instanceof Element)) return;

		if (event.target.closest('.menu-toggle')) {
			setMenu(true);
		} else if (event.target.closest('.menu-close')) {
			setMenu(false);
		}
	});

	document.addEventListener('keydown', (event: KeyboardEvent) => {
		const menu = document.getElementById('site-menu');

		if (event.key === 'Escape' && menu?.classList.contains('translate-x-0')) {
			setMenu(false);
		}
	});
</script>
