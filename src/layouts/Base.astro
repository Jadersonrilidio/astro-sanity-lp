---
import '../styles/global.css';
const { content } = Astro.props;
---

<html lang="pt-BR" class="h-full bg-white text-text antialiased">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="title" content={content.title} />
		<meta name="description" content={content.description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.svg" />
		<title>{content.title}</title>
	</head>
	<body class="m-0 flex min-h-screen flex-col bg-white text-text font-sans">
		<header class="flex h-header-height items-center justify-between px-(--spacing-gutter)">
			<a class="inline-flex leading-none" href="/" aria-label="MICRA home">
				<img src="/assets/logo-micra.svg" alt="micra logo" class="h-10 w-auto" />
			</a>

			<button
				type="button"
				class="menu-toggle flex h-7.5 w-9 flex-col justify-between border-0 bg-transparent p-0 text-text hover:text-primary active:text-primary-click cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-6 focus-visible:outline-primary"
				aria-label="Abrir menu"
				aria-controls="site-menu"
				aria-expanded="false"
			>
				<span class="block h-0.75 w-full bg-current"></span>
				<span class="block h-0.75 w-full bg-current"></span>
				<span class="block h-0.75 w-full bg-current"></span>
				<span class="block h-0.75 w-full bg-current"></span>
			</button>

			<div
				id="site-menu"
				class="menu fixed inset-0 z-50 flex translate-x-full flex-col bg-primary px-(--spacing-gutter) pb-[12vh] text-(--color-on-primary) opacity-100 invisible pointer-events-none transition-all duration-(--duration-menu) ease-menu motion-reduce:transition-none"
				role="dialog"
				aria-modal="true"
				aria-label="Menu"
			>
				<button
					type="button"
					class="menu-close absolute right-(--spacing-gutter) top-[calc((var(--spacing-header-height)-30px)/2)] h-7.5 w-9 border-0 bg-transparent p-0 text-current cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-6 focus-visible:outline-(--color-on-primary)"
					aria-label="Fechar menu"
				>
					<svg viewBox="0 0 36 30" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" class="block h-full w-full">
						<path d="M3 -1L33 31M33 -1L3 31"/>
					</svg>
				</button>

				<nav class="menu-nav mt-auto" aria-label="Menu principal">
					<ul class="m-0 flex list-none flex-col gap-[0.35em] p-0">
						<li><a href="#sobre" class="font-(--font-menu) text-[clamp(2rem,9vw,3rem)] uppercase leading-tight tracking-[0.04em] text-inherit no-underline">Sobre</a></li>
						<li><a href="#projetos" class="font-(--font-menu) text-[clamp(2rem,9vw,3rem)] uppercase leading-tight tracking-[0.04em] text-inherit no-underline">Projetos</a></li>
						<li><a href="/contato" class="font-(--font-menu) text-[clamp(2rem,9vw,3rem)] uppercase leading-tight tracking-[0.04em] text-inherit no-underline">Contato</a></li>
					</ul>
				</nav>

				<div class="menu-social mt-[clamp(48px,12vh,120px)] flex justify-center gap-14">
					<a href="#" aria-label="Instagram" class="inline-flex text-inherit focus-visible:outline-2 focus-visible:outline-offset-6 focus-visible:outline-(--color-on-primary)">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-8 w-8">
							<rect x="3" y="3" width="18" height="18" rx="5"/>
							<circle cx="12" cy="12" r="4"/>
							<circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"/>
						</svg>
					</a>
					<a href="#" aria-label="WhatsApp" class="inline-flex text-inherit focus-visible:outline-2 focus-visible:outline-offset-6 focus-visible:outline-(--color-on-primary)">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-8 w-8">
							<path d="M12 3a9 9 0 0 0-7.7 13.6L3 21l4.5-1.2A9 9 0 1 0 12 3z"/>
							<path transform="translate(6.6 6.6) scale(.45)" stroke-width="3.5" d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/>
						</svg>
					</a>
					<a href="#" aria-label="E-mail" class="inline-flex text-inherit focus-visible:outline-2 focus-visible:outline-offset-6 focus-visible:outline-(--color-on-primary)">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-8 w-8">
							<rect x="3" y="5" width="18" height="14" rx="2"/>
							<path d="M3 7l9 6 9-6"/>
						</svg>
					</a>
				</div>
			</div>
		</header>

		<main class="flex flex-1 items-center justify-center">
			<slot />
		</main>
	</body>
</html>

<script>
	const menu = document.getElementById('site-menu');
	const openBtn = document.querySelector<HTMLButtonElement>('.menu-toggle');
	const closeBtn = document.querySelector<HTMLButtonElement>('.menu-close');

	if (!menu || !openBtn || !closeBtn) {
		throw new Error('Required menu elements were not found.');
	}

	function setMenu(open: boolean): void {
		if (!menu || !openBtn || !closeBtn) return;

		menu.classList.toggle('pointer-events-auto', open);
		menu.classList.toggle('translate-x-0', open);
		menu.classList.toggle('visible', open);
		menu.classList.toggle('opacity-100', open);
		menu.classList.toggle('pointer-events-none', !open);
		menu.classList.toggle('translate-x-full', !open);
		menu.classList.toggle('invisible', !open);
		menu.classList.toggle('opacity-100', !open);
		document.body.classList.toggle('overflow-hidden', open);
		openBtn.setAttribute('aria-expanded', String(open));
		(open ? closeBtn : openBtn).focus({ preventScroll: true });
	}

	openBtn.addEventListener('click', () => setMenu(true));
	closeBtn.addEventListener('click', () => setMenu(false));
	menu.addEventListener('click', (event: MouseEvent) => {
		if (event.target instanceof Element && event.target.closest('.menu-nav a')) {
			setMenu(false);
		}
	});
	document.addEventListener('keydown', (event: KeyboardEvent) => {
		if (event.key === 'Escape' && menu.classList.contains('translate-x-0')) {
			setMenu(false);
		}
	});
</script>
